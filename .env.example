# Copier ce fichier en .env.local et adapter les valeurs

# Port de l'API HTTP
PORT=3001

# Port du serveur WebSocket
WS_PORT=8080

# Origines autorisées à appeler l'API, séparées par des virgules
# (si vide : toutes les origines sont autorisées)
CORS_ORIGIN=http://localhost:3000

# Chemin du fichier JSON du compte de service Google
# (par défaut : credentials.json à la racine du projet)
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/credentials.json

# Secret NextAuth : doit être IDENTIQUE au NEXTAUTH_SECRET du front
# (sert à déchiffrer le cookie de session)
NEXTAUTH_SECRET=

# IDs des classeurs Google Sheets accessibles via l'API, séparés par des virgules
# (si vide : tous les classeurs partagés avec le compte de service sont accessibles)
ALLOWED_SPREADSHEET_IDS=1NSbrkreltnCwihnE9tC24sVdDb5Tp5zCknzOXJKc2dQ
