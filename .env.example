# Copier ce fichier en .env.local et adapter les valeurs

# Port de l'API HTTP
PORT=3001

# Port du serveur WebSocket
WS_PORT=8080

# Origines autorisées à appeler l'API, séparées par des virgules
# (si vide : toutes les origines sont autorisées)
CORS_ORIGIN=http://localhost:3000

# Chemin du fichier JSON du compte de service Google
# (par défaut : credentials.json à la racine du projet)
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/credentials.json
